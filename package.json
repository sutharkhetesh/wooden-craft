{
  "name": "grain-and-form",
  "version": "1.0.0",
  "private": true,
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  },
  "scripts": {
    "db:schema:validate": "prisma validate",
    "db:schema:format": "prisma format",
    "db:migrate": "prisma migrate deploy",
    "db:check": "node --import tsx scripts/database/check.ts",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:hosted": "prisma generate && node scripts/build/hosted.mjs",
    "test:browser": "node scripts/qa/browser.mjs",
    "test:responsive": "node scripts/qa/responsive.mjs",
    "test:products": "node scripts/qa/products.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "test:db:migration": "node scripts/database/verify-migration.mjs",
    "test:db:submissions": "node --import tsx scripts/database/verify-submissions.ts",
    "test:improvements": "node scripts/qa/improvements.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.2.1",
    "@next/env": "^15.5.29",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lenis": "^1.3.27",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "tailwind-merge": "^3.4.0",
    "ws": "^8.23.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
