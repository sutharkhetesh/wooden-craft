# Public business information: leave blank until real information is available.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_HOURS=
NEXT_PUBLIC_MAP_QUERY=
# Set a strong password and a random secret of at least 32 characters to enable admin.
ADMIN_PASSWORD=
SESSION_SECRET=
# Optional PostgreSQL. Without this, local persistent files are used in DATA_DIRECTORY.
DATABASE_URL=
DATA_DIRECTORY=.data
# Only enable behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
