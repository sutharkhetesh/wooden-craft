# Neon pooled connection for application queries. Server-only.
DATABASE_URL="postgresql://USER:PASSWORD@ep-PROJECT-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Neon direct connection for Prisma migrations and schema tooling.
DIRECT_URL="postgresql://USER:PASSWORD@ep-PROJECT.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Optional without DATABASE_URL: absolute path to a mounted persistent volume.
# With DATABASE_URL, Node uploads store image bytes directly in Neon.
# Defaults to .data locally. Serverless /tmp is not durable upload storage.
# DATA_DIRECTORY="/mnt/persistent/enteak"


# Public site URL used for canonical URLs, sitemap and structured data.
# Defaults to https://www.enteak.in when unset.
# NEXT_PUBLIC_SITE_URL="https://www.enteak.in"

# Optional Google Analytics 4 measurement ID (G-XXXXXXXXXX). Analytics loads only
# when this is set AND the visitor accepts the consent prompt.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Optional Resend email alerts to the studio after an enquiry is saved.
# Add a sending API key, a sender on your verified Resend domain, and the owner
# inbox that should receive alerts. All three are server-only; no NEXT_PUBLIC_.
# For Sites hosting, configure the same values as Worker runtime secrets.
# RESEND_API_KEY="re_your_api_key"
# RESEND_FROM_EMAIL="Enteak <enquiries@your-verified-domain.com>"
# ENQUIRY_NOTIFICATION_EMAIL="your-inbox@example.com"
